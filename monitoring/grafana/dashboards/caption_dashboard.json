    {
      "type": "timeseries",
      "id": 12,
      "title": "CPU usage (bulk jobs shaded)",
      "description": "Machine CPU % (node_exporter, all 4 cores) and the app's own CPU (100% = 1 core). Grey = bulk job running. Linear scale.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[30s])))",
          "legendFormat": "machine CPU %",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * rate(process_cpu_seconds_total{job=\"caption_app\"}[30s])",
          "legendFormat": "app CPU % (per core)",
          "refId": "B",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(caption_active_requests{mode=\"bulk\"})",
          "legendFormat": "bulk job running",
          "refId": "C",
          "range": true,
          "instant": false
        }
      ],
